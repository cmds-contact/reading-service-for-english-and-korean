      "type": "h2",
      "text": "Network access and security"
    },
    {
      "type": "h3",
      "text": "Network policy"
    },
    {
      "type": "h4",
      "text": "GitHub proxy"
    },
    {
      "type": "li",
      "text": "Manages GitHub authentication securely - the git client uses a scoped credential inside the sandbox, which the proxy verifies and translates to your actual GitHub authentication token"
    },
    {
      "type": "li",
      "text": "Restricts git push operations to the current working branch for safety"
    },
    {
      "type": "li",
      "text": "Enables seamless cloning, fetching, and PR operations while maintaining security boundaries"
    },
    {
      "type": "h4",
      "text": "Security proxy"
    },
    {
      "type": "li",
      "text": "Protection against malicious requests"
    },
    {
      "type": "li",
      "text": "Rate limiting and abuse prevention"
    },
    {
      "type": "li",
      "text": "Content filtering for enhanced security"
    },
